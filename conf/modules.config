/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
    ext.args   = Additional arguments appended to command in module.
    ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
    ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
    ext.prefix = File name prefix for output files.

    Output layout:
    ${outdir}/bam/          - final, analysis-ready (deduplicated, indexed) BAM - one of the pipeline's headline outputs
    ${outdir}/vcf/          - final germline VCF (+ index) from GATK HaplotypeCaller - headline output
    ${outdir}/cnv/          - CNVkit copy-number calls (segments + VCF) - headline output
    ${outdir}/qc_metrics/   - flat, tabular QC metrics file - headline output
    ${outdir}/alignment/    - intermediate alignment artifacts and per-tool QC reports feeding MultiQC
    ${outdir}/reference/    - generated reference indices (.fai, .dict), so they can be reused on the next run
    ${outdir}/multiqc/      - aggregated HTML QC report
    ${outdir}/pipeline_info/ - execution reports and software versions

    Resource overrides below are sized for human WES (exome) data against the full hg38
    reference - see the top of conf/base.config for the general rationale. Processes that
    scale with whole-genome size rather than exome data size (BWA_INDEX, GATK4_MARKDUPLICATES,
    GATK4_HAPLOTYPECALLER, CNVKIT_BATCH) get explicit overrides here rather than relying on
    their default label, since "exome data but whole-genome reference" doesn't fit neatly
    into the generic process_low/medium/high tiers.
----------------------------------------------------------------------------------------
*/

process {

    // Fallback for any process not explicitly configured below: group by tool name.
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]

    //
    // ALIGNMENT subworkflow
    //

    withName: BWA_INDEX {
        // bwa index is single-threaded and its memory/time scale with the *reference* size
        // (hg38 ~3.1 Gb), not with how much exome data will later be aligned to it. Runs once
        // per pipeline execution (or not at all if --bwa_index is supplied).
        cpus       = 1
        memory     = { 16.GB * task.attempt }
        time       = { 6.h * task.attempt }
        publishDir = [path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode]
    }

    withName: SAMTOOLS_FAIDX {
        publishDir = [path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode]
    }

    withName: BWA_MEM {
        // A read group (@RG) is required by downstream GATK tools (MarkDuplicates, HaplotypeCaller).
        ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
        // sort_bam = true (set in subworkflows/local/alignment) already coordinate-sorts via samtools
        publishDir = [path: { "${params.outdir}/alignment/aligned_bam" }, mode: params.publish_dir_mode]
    }

    withName: SAMTOOLS_INDEX_ALIGN {
        publishDir = [path: { "${params.outdir}/alignment/aligned_bam" }, mode: params.publish_dir_mode]
    }

    withName: FASTQC {
        // Input here is the aligned BAM, not raw FASTQ - tell FastQC explicitly rather than relying on autodetection.
        ext.args   = '--format bam --quiet'
        publishDir = [path: { "${params.outdir}/alignment/fastqc" }, mode: params.publish_dir_mode]
    }

    withName: SAMTOOLS_FLAGSTAT {
        publishDir = [path: { "${params.outdir}/alignment/samtools_flagstat" }, mode: params.publish_dir_mode]
    }

    withName: SAMTOOLS_STATS {
        publishDir = [path: { "${params.outdir}/alignment/samtools_stats" }, mode: params.publish_dir_mode]
    }

    //
    // VARIANT_CALLING subworkflow
    //

    withName: GATK4_CREATESEQUENCEDICTIONARY {
        publishDir = [path: { "${params.outdir}/reference" }, mode: params.publish_dir_mode]
    }

    withName: GATK4_MARKDUPLICATES {
        // Must differ from the upstream aligned BAM's name ("<id>.bam"), or GATK would write its
        // output over the staged input file in place and Nextflow would silently emit no output.
        ext.prefix = { "${meta.id}.markdup.bam" }
        // ext.args: add e.g. '--REMOVE_DUPLICATES true' here to drop duplicates instead of just flagging them.
        // Picard sorts read-ends in memory before spilling to disk; a typical ~100x exome (tens
        // of millions of read pairs) benefits from more headroom than the generic process_low tier.
        cpus       = { 4 * task.attempt }
        memory     = { 16.GB * task.attempt }
        time       = { 6.h * task.attempt }
        publishDir = [
            [path: { "${params.outdir}/bam" }, mode: params.publish_dir_mode, pattern: '*.bam'],
            [path: { "${params.outdir}/variant_calling/markduplicates_metrics" }, mode: params.publish_dir_mode, pattern: '*.metrics'],
        ]
    }

    withName: SAMTOOLS_INDEX_DEDUP {
        publishDir = [path: { "${params.outdir}/bam" }, mode: params.publish_dir_mode]
    }

    withName: GATK4_HAPLOTYPECALLER {
        // --interval-padding only applies when --intervals is set (exome capture BED/interval_list);
        // 100bp is GATK's standard recommendation to catch variants near exon boundaries.
        // Add e.g. '-ERC GVCF' here (on top of the padding) to emit gVCFs for later joint genotyping.
        ext.args = { params.intervals ? '--interval-padding 100' : '' }
        // With --intervals restricting calling to the exome, this is fast; the memory bump
        // over process_low mainly buys GATK's JVM a bit more headroom (task.memory feeds its -Xmx).
        memory     = { 8.GB * task.attempt }
        time       = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/vcf" }, mode: params.publish_dir_mode]
    }

    //
    // CNV_CALLING subworkflow
    //

    withName: CNVKIT_BATCH {
        // Builds target/antitarget bins and a flat reference against the *whole* hg38 fasta
        // (not just the capture regions), so give it more than the default process_low tier.
        cpus       = { 4 * task.attempt }
        memory     = { 12.GB * task.attempt }
        time       = { 4.h * task.attempt }
        publishDir = [path: { "${params.outdir}/cnv" }, mode: params.publish_dir_mode]
    }

    withName: CNVKIT_EXPORT {
        // Converts CNVkit's *.call.cns segments to VCF.
        ext.args   = 'vcf'
        publishDir = [path: { "${params.outdir}/cnv" }, mode: params.publish_dir_mode]
    }

    //
    // QC summary
    //

    withName: QC_METRICS_TABLE {
        publishDir = [path: { "${params.outdir}/qc_metrics" }, mode: params.publish_dir_mode]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        cpus       = { 2 * task.attempt }
        memory     = { 8.GB * task.attempt }
        time       = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode]
    }
}
