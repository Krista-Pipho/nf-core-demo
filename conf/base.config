/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    kpipho/varcall Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.

    Sizing below assumes the pipeline's primary use case: human WES (exome) data against
    the full hg38 reference. Two things pull in opposite directions here:
    - Per-sample read volume is much smaller than WGS (exome capture is ~1-2% of the
    genome), so most per-sample steps need far less time/memory than a WGS pipeline.
    - A handful of steps (BWA_MEM, CNVKIT_BATCH) still load or scan the *whole* hg38
    reference regardless of how few reads are aligned to it, so their memory floor is
    set by genome size, not by exome data size, and doesn't shrink with smaller inputs.
    If you switch to WGS data, revisit `process_medium`/`process_high` and the explicit
    per-process overrides in conf/modules.config (GATK4_MARKDUPLICATES, GATK4_HAPLOTYPECALLER,
    CNVKIT_BATCH) - those scale with read depth across the whole genome, not just the exome.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // BWA_MEM carries `label 'process_high'` below. Its memory floor is dominated by loading
    // the hg38 BWA index (~5-6 GB for the FM-index alone) plus per-thread buffers - 24 GB
    // leaves comfortable headroom at 8 threads for exome-sized read volumes. On a smaller
    // reference (e.g. the chr22-only test data) this is far more than needed; on WGS data,
    // or a reference larger than hg38, you likely want to raise it back towards 48-72 GB.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel: process_single {
        cpus   = { 1                    }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2    * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 3.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
