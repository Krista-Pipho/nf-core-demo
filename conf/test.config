/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    kpipho/varcall test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the pipeline against the small, synthetic dataset under tests/data/
    (generate it first with `python3 tests/generate_test_data.py`, or just run
    tests/run_tests.sh, which does that for you). This is a fast correctness
    smoke test, not a representative benchmark - see tests/README.md.

    Usage:
        nextflow run . -profile test,singularity --outdir test_results
----------------------------------------------------------------------------------------
*/

params {
    input     = "${projectDir}/tests/data/samplesheet.csv"
    fasta     = "${projectDir}/tests/data/reference/genome.fa"
    intervals = "${projectDir}/tests/data/reference/capture_targets.bed"
    outdir    = "test_results"
}

process {
    // The real defaults in conf/base.config/conf/modules.config are sized for exome data
    // against the full hg38 reference (see the comments there) - comically oversized for a
    // 30kb synthetic test genome. Cap every process at something a laptop or a small HPC
    // test allocation can satisfy, regardless of which label/name-based override it hits.
    resourceLimits = [cpus: 4, memory: 6.GB, time: 30.min]
}
